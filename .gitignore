# Disposable proof workspace for the proposed @victframework/cognee pack
# (C0/C1 discovery). Remote: https://github.com/radz2291/VICT-Cognee
# Discovery-only repo: no pack design, no implementation.

# Python virtualenv for the pinned cognee proof
proof/.venv/

# Upstream cognee clone (own git repo, pinned separately; never edited)
upstream/

# Clean-checkout used to verify fresh-clone runnability
clean-checkout/

# Node SDK test checkout (its runtime state stays out of Git)
ts-sdk/node_modules/
ts-sdk/package-lock.json
ts-sdk/.cognee_system/
ts-sdk/*.db
ts-sdk/*.db-wal
ts-sdk/*.db-shm

# Cognee runtime state (databases, caches, logs) — regenerated by run_proof.sh
.cognee/
proof/.cognee/
proof/.env
proof/logs/
logs/

# Synthetic input fixtures under proof/data/ ARE tracked (needed for fresh clones);
# only stray generated files there are ignored.
proof/data/*
!proof/data/quellight_like.txt
!proof/data/trading_like.txt
!proof/data/malay_probe.txt

# Python noise
__pycache__/
*.pyc
