{
  "name": "@victframework/cognee",
  "version": "0.1.0",
  "private": true,
  "description": "Keyless Cognee memory capability pack for VICT — one runtime per trust domain; keyed durable writes with a scope safety rail. UNPUBLISHED C5 candidate (proof artifact; npm refuses to publish a private package).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@victframework/sdk": "^0.1.0",
    "@victframework/runtime": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@victframework/sdk": { "optional": true },
    "@victframework/runtime": { "optional": true }
  },
  "license": "UNLICENSED",
  "scripts": {
    "build": "node scripts/build.mjs",
    "pack:check": "npm pack",
    "verify": "tsx verify/verify.ts",
    "verify:ownership": "tsx verify/ownership-verify.ts",
    "proof:c4": "node ../../worker/proof_c4.mjs",
    "proof:equiv": "node ../../worker/graph_equiv_c4.mjs"
  }
}
