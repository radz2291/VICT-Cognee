# Proof environment for the pinned cognee==1.6.1 proof runs (keyless local route).
# SAFE EXAMPLE — no credentials. Copy to proof/.env before running; proof/run_proof.sh
# does this automatically and replaces @PROOF_DIR@ with the absolute proof/ directory.
# RESOLUTION MODEL (observed + source-confirmed, cognee 1.6.1): in script mode cognee
# finds .env by dotenv walk-up anchored at the INSTALLED PACKAGE — with the venv inside
# proof/ this file is the one found; an external interpreter (PROOF_PY) may adopt a
# foreign .env above its venv, or default to site-packages. load_dotenv(override=True)
# means this file beats process-env overrides. proof/guard_store_roots.py (wired into
# battery_common and run_proof.sh) verifies every destructive storage root actually
# resolved into this disposable workspace and fails closed otherwise.

ENV=dev
RUNTIME__LOG_LEVEL=INFO

# Redirect all writable roots into the disposable workspace (never site-packages, never ~/.cognee)
SYSTEM_ROOT_DIRECTORY=@PROOF_DIR@/.cognee/system
DATA_ROOT_DIRECTORY=@PROOF_DIR@/.cognee/data
CACHE_ROOT_DIRECTORY=@PROOF_DIR@/.cognee/cache
LOGS_ROOT_DIRECTORY=@PROOF_DIR@/.cognee/logs
COGNEE_REPOS_DIR=@PROOF_DIR@/.cognee/repos

# Embedded databases (no external services)
VECTOR_DB_PROVIDER=lancedb
GRAPH_DATABASE_PROVIDER=ladybug
DB_PROVIDER=sqlite

# Keyless local inference: fastembed embeddings + GLiNER extraction.
# OBSERVED PITFALL (smoke_01 run 2): setting EMBEDDING_PROVIDER=fastembed without
# EMBEDDING_MODEL keeps the cloud default openai/text-embedding-3-large, which
# fastembed rejects at engine construction. Provider+model+dimensions must be
# set together for a local keyless install.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
GRAPH_EXTRACTOR=gliner_demo

# Keep LLM-dependent defaults observable but non-fatal where possible
AUTO_FEEDBACK=false

# NO LLM credentials are used or required by this proof. If a maintainer later adds
# an LLM key locally, put it in proof/.env (git-ignored) — never in this example.
